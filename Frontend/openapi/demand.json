            "type": "string",
            "enum": ["LOW", "MID", "HIGH", "UNKNOWN"]
          },
          "typicalPriceLow": {
            "type": "integer",
            "format": "int64"
          },
          "typicalPriceHigh": {
            "type": "integer",
