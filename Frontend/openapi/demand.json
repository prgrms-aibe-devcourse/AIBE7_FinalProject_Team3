      },
      "DemandCalculateRequest": {
        "type": "object",
        "properties": {
          "conversionBasis": {
            "type": "string",
            "enum": ["OWN", "MARKET"]
          },
          "conversionRate": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          },
          "safetyStockRate": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          }
        }
      },
      "ApiResponseDemandPlanResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/DemandPlanResponse"
          },
          "message": {
            "type": "string"
          }
        }
