  "components": {
    "schemas": {
      "OptionInput": {
        "type": "object",
        "properties": {
          "unitPrice": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": ["unitPrice"]
      },
      "StockRecommendationRequest": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionInput"
            },
            "maxItems": 100,
            "minItems": 1
          },
          "safetyStockRate": {
            "type": "number",
            "maximum": 1,
            "minimum": 0
          }
        },
        "required": ["categoryId", "options"]
      },
      "ApiResponseStockRecommendationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/StockRecommendationResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MarketSales": {
        "type": "object",
        "properties": {
          "soldLow": {
            "type": "integer",
            "format": "int32"
          },
          "soldMedian": {
            "type": "integer",
            "format": "int32"
          },
          "soldHigh": {
            "type": "integer",
            "format": "int32"
          },
          "sellThroughRate": {
            "type": "number"
          },
          "soldOutRate": {
            "type": "number"
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "LOW", "NONE"]
          },
          "dropCountBand": {
            "type": "string"
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OptionRecommendation": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "recommendedQuantity": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "OwnSales": {
        "type": "object",
        "properties": {
          "soldLow": {
            "type": "integer",
            "format": "int32"
          },
          "soldMedian": {
            "type": "integer",
            "format": "int32"
          },
          "soldHigh": {
            "type": "integer",
            "format": "int32"
          },
          "sellThroughRate": {
            "type": "number"
          },
          "soldOutRate": {
            "type": "number"
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "LOW", "NONE"]
          },
          "dropCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PriceBand": {
        "type": "object",
        "properties": {
          "band": {
            "type": "string",
            "enum": ["LOWER", "SIMILAR", "HIGHER"]
          },
          "sellThroughRate": {
            "type": "number"
          },
          "dropCountBand": {
            "type": "string"
          }
        }
      },
      "PriceReference": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "enum": ["LOW", "MID", "HIGH", "UNKNOWN"]
          },
          "typicalPriceLow": {
            "type": "integer",
            "format": "int64"
          },
          "typicalPriceHigh": {
            "type": "integer",
            "format": "int64"
          },
          "bands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceBand"
            }
          }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "low": {
            "type": "integer",
            "format": "int32"
          },
          "expected": {
            "type": "integer",
            "format": "int32"
          },
          "high": {
            "type": "integer",
            "format": "int32"
          },
          "recommended": {
            "type": "integer",
            "format": "int32"
          },
          "safetyStockRate": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionRecommendation"
            }
          }
        }
      },
      "StockRecommendationResponse": {
        "type": "object",
        "properties": {
          "calculatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "calculationVersion": {
            "type": "string"
          },
          "referencePrice": {
            "type": "integer",
            "format": "int64"
          },
          "own": {
            "$ref": "#/components/schemas/OwnSales"
          },
          "market": {
            "$ref": "#/components/schemas/MarketSales"
          },
          "basis": {
            "type": "string",
