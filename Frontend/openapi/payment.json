{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "주문 취소",
      "description": "구매자의 주문 취소와 결제 취소·재고 반환"
    },
    {
      "name": "결제",
      "description": "토스페이먼츠 테스트 환경 Mock 결제 승인과 주문 결제 이력 조회"
    }
  ],
  "paths": {
    "/api/v1/orders/{orderId}/payments": {
      "get": {
        "tags": ["결제"],
        "summary": "주문 결제 이력 조회",
        "description": "본인 주문의 모든 결제 시도와 결과를 시도 순서대로 반환한다. 시도가 없으면 빈 배열이다",
        "operationId": "findPayments",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListPaymentHistoryResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListPaymentHistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND (UUID 형식 오류), ORDER_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListPaymentHistoryResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["결제"],
        "summary": "Mock 결제 요청",
        "description": "결제창에서 받은 paymentKey로 토스페이먼츠 테스트 결제를 승인한다. 실제 결제는 일어나지 않는다. Idempotency-Key(UUID) 헤더가 필요하다. 승인 결과는 200의 status(SUCCEEDED·FAILED·UNKNOWN·PENDING)로 구분하며, UNKNOWN이면 같은 키와 본문으로 다시 보내 결과를 확인한다",
        "operationId": "pay",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "결제 시도 결과 반환",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_IDEMPOTENCY_KEY, VALIDATION_FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED (CSRF 토큰 누락)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND (UUID 형식 오류), ORDER_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_IDEMPOTENCY_KEY, PAYMENT_ALREADY_PROCESSED, INVALID_STATE_TRANSITION",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          },
          "422": {
            "description": "PAYMENT_AMOUNT_MISMATCH, PAYMENT_EXPIRED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{orderId}/cancel": {
      "post": {
        "tags": ["주문 취소"],
        "summary": "주문 취소",
        "description": "PAYMENT_PENDING·PAID·PREPARING 주문을 취소한다. 결제한 주문은 토스페이먼츠 테스트 결제를 취소한다. Idempotency-Key(UUID) 헤더가 필요하다. 결제 취소 결과를 확인 중이면 200과 refundStatus: UNKNOWN으로 응답한다",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "취소 완료 또는 결제 취소 결과 확인 중",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, INVALID_IDEMPOTENCY_KEY, VALIDATION_FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED (CSRF 토큰 누락)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          },
          "404": {
            "description": "RESOURCE_NOT_FOUND (UUID 형식 오류), ORDER_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_IDEMPOTENCY_KEY, ORDER_NOT_CANCELABLE, ORDER_STATUS_CONFLICT",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          },
          "502": {
            "description": "PAYMENT_CANCEL_FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderCancelResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentRequest": {
        "type": "object",
        "properties": {
          "paymentKey": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": ["amount", "paymentKey"]
      },
      "ApiResponsePaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/PaymentResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Failure": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "orderNumber": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SUCCEEDED", "FAILED", "UNKNOWN", "CANCELED"]
          },
          "reconciliationStatus": {
            "type": "string",
            "enum": ["NONE", "REQUIRED", "RESOLVED"]
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          },
          "failure": {
            "$ref": "#/components/schemas/Failure"
          }
        }
      },
      "OrderCancelRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": ["reason"]
      },
      "ApiResponseOrderCancelResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/OrderCancelResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "OrderCancelResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PAYMENT_PENDING",
              "PAID",
              "PREPARING",
              "SHIPPED",
              "DELIVERED",
              "EXPIRED",
              "CANCELED"
            ]
          },
          "refundStatus": {
            "type": "string",
            "enum": ["NONE", "SUCCEEDED", "UNKNOWN"]
          },
          "canceledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponseListPaymentHistoryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentHistoryResponse"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PaymentHistoryResponse": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "type": "string",
            "enum": ["MOCK", "TOSS"]
          },
          "amount": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "SUCCEEDED", "FAILED", "UNKNOWN", "CANCELED"]
          },
          "reconciliationStatus": {
            "type": "string",
            "enum": ["NONE", "REQUIRED", "RESOLVED"]
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          },
          "canceledAt": {
            "type": "string",
            "format": "date-time"
          },
          "failure": {
            "$ref": "#/components/schemas/Failure"
          }
        }
      }
    }
  }
}
