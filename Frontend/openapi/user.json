{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "토큰 재발급",
      "description": "Refresh Token Rotation"
    },
    {
      "name": "CSRF",
      "description": "상태 변경 요청에 쓸 CSRF 토큰 발급"
    },
    {
      "name": "로그인",
      "description": "LOCAL 이메일·비밀번호 로그인"
    },
    {
      "name": "소셜 로그인",
      "description": "KAKAO·GOOGLE 소셜 로그인과 최초 소셜 회원가입"
    },
    {
      "name": "내 정보",
      "description": "로그인한 사용자의 회원 정보 조회"
    },
    {
      "name": "회원가입",
      "description": "이메일 인증을 마친 LOCAL 회원가입"
    },
    {
      "name": "이메일 인증",
      "description": "LOCAL 회원가입용 이메일 인증 코드 요청·확인"
    },
    {
      "name": "로그아웃",
      "description": "Refresh Token 세션 폐기와 인증 쿠키 만료"
    }
  ],
  "paths": {
    "/api/v1/auth/signup": {
      "post": {
        "tags": ["회원가입"],
        "summary": "회원가입 완료",
        "description": "email_signup_token 쿠키의 인증된 이메일로 가입한다. 성공하면 쿠키를 만료시킨다",
        "operationId": "signup",
        "parameters": [
          {
            "name": "email_signup_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "가입 성공, Set-Cookie로 가입 토큰 만료",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSignupResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, VALIDATION_FAILED, INVALID_PASSWORD, INVALID_NICKNAME",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSignupResponse"
                }
              }
            }
          },
          "401": {
            "description": "EMAIL_SIGNUP_CONTEXT_INVALID",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSignupResponse"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_EMAIL, DUPLICATE_NICKNAME",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSignupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["토큰 재발급"],
        "summary": "토큰 재발급",
        "description": "refresh_token 쿠키로 Access·Refresh Token을 새로 발급한다. 사용한 Refresh Token은 폐기된다",
        "operationId": "refresh",
        "responses": {
          "204": {
            "description": "재발급 성공, Set-Cookie로 access_token·refresh_token 전달"
          },
          "401": {
            "description": "INVALID_TOKEN"
          },
          "403": {
            "description": "ACCESS_DENIED(CSRF 토큰 없음·불일치)"
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR(Redis 장애 등. 로그아웃하지 않고 다시 시도한다)"
          }
        }
      }
    },
    "/api/v1/auth/oauth2/signup": {
      "post": {
        "tags": ["소셜 로그인"],
        "summary": "소셜 회원가입 완료",
        "description": "oauth2_signup_token 쿠키의 제공자·이메일과 입력한 닉네임으로 가입하고 로그인시킨다. 토큰은 HttpOnly 쿠키로만 전달한다",
        "operationId": "signup_1",
        "parameters": [
          {
            "name": "oauth2_signup_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuth2SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "가입 성공, Set-Cookie로 가입 토큰 만료와 access_token·refresh_token 전달",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, VALIDATION_FAILED, INVALID_NICKNAME",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "OAUTH2_SIGNUP_CONTEXT_INVALID",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED(CSRF 토큰 없음·불일치)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "409": {
            "description": "DUPLICATE_EMAIL, DUPLICATE_NICKNAME",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["로그아웃"],
        "summary": "로그아웃",
        "description": "refresh_token 쿠키의 세션을 폐기하고 두 인증 쿠키를 만료시킨다. 쿠키가 없거나 이미 폐기된 토큰이어도 204다",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "로그아웃 성공, Set-Cookie로 access_token·refresh_token 만료"
          },
          "403": {
            "description": "ACCESS_DENIED(CSRF 토큰 없음·불일치)"
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR(Redis 장애 등. 쿠키가 유지되므로 다시 시도한다)"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["로그인"],
        "summary": "로그인",
        "description": "이메일·비밀번호로 로그인한다. Access·Refresh Token은 HttpOnly 쿠키로만 전달한다",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "로그인 성공, Set-Cookie로 access_token·refresh_token 전달",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST, VALIDATION_FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_DISABLED, ACCESS_DENIED(CSRF 토큰 없음·불일치)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/email-verification": {
      "post": {
        "tags": ["이메일 인증"],
        "summary": "이메일 인증 코드 요청",
        "description": "가입 여부와 관계없이 같은 응답이며, 메일 발송 완료를 기다리지 않는다. 발송 제한은 MEMBER_AUTH.md 1.2 참고",
        "operationId": "requestCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "요청 처리 완료"
          },
          "400": {
            "description": "INVALID_REQUEST, VALIDATION_FAILED, INVALID_EMAIL"
          },
          "429": {
            "description": "EMAIL_VERIFICATION_RESEND_TOO_SOON"
          }
        }
      }
    },
    "/api/v1/auth/email-verification/confirm": {
      "post": {
        "tags": ["이메일 인증"],
        "summary": "이메일 인증 코드 확인",
        "description": "성공하면 15분간 유효한 가입 토큰을 email_signup_token HttpOnly 쿠키로 발급한다. 코드 형식 오류는 시도 횟수에 포함하지 않는다",
        "operationId": "confirmCode",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerificationConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "확인 성공, Set-Cookie로 가입 토큰 발급"
          },
          "400": {
            "description": "INVALID_REQUEST, VALIDATION_FAILED, INVALID_EMAIL, EMAIL_VERIFICATION_CODE_MISMATCH, EMAIL_VERIFICATION_CODE_EXPIRED"
          },
          "409": {
            "description": "DUPLICATE_EMAIL"
          },
          "429": {
            "description": "EMAIL_VERIFICATION_ATTEMPTS_EXCEEDED"
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": ["내 정보"],
        "summary": "내 정보 조회",
        "description": "본인의 회원 정보를 반환한다. provider는 가입 방식, roles는 요청 Access Token의 권한이고, profileImageUrl은 없으면 null이다",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserMeResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED(쿠키 없음, 회원 없음·정지·탈퇴), INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserMeResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserMeResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_SERVER_ERROR",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserMeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oauth2/{provider}": {
      "get": {
        "tags": ["소셜 로그인"],
        "summary": "소셜 로그인 시작",
        "description": "브라우저를 이 주소로 이동시킨다. kakao·google이면 302로 제공자 인증 화면에 보내고, 인증 후 결과는 프론트엔드 콜백 주소의 result(success·signup_required) 또는 error 쿼리로 전달한다",
        "operationId": "start",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "kakao 또는 google",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "제공자 인증 화면으로 이동"
          },
          "400": {
            "description": "UNSUPPORTED_OAUTH2_PROVIDER"
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": ["CSRF"],
        "summary": "CSRF 토큰 발급",
        "description": "XSRF-TOKEN 쿠키를 발급한다. POST·PUT·PATCH·DELETE 요청 전에 먼저 호출한다(Swagger UI의 Try it out 포함)",
        "operationId": "issueCsrfToken",
        "responses": {
          "204": {
            "description": "발급 완료, Set-Cookie로 XSRF-TOKEN 전달"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1
          },
          "nickname": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["nickname", "password"]
      },
      "ApiResponseSignupResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/SignupResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OAuth2SignupRequest": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["nickname"]
      },
      "ApiResponseLoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/LoginResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["email", "password"]
      },
      "EmailVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["email"]
      },
      "EmailVerificationConfirmRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "pattern": "[0-9]{6}"
          }
        },
        "required": ["code", "email"]
      },
      "ApiResponseUserMeResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/UserMeResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "UserMeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": ["LOCAL", "KAKAO", "GOOGLE"]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profileImageUrl": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
