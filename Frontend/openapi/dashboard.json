          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseDropStatsResponse"
                }
              }
            }
          }
        }
      }
    }
