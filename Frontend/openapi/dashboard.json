  "paths": {
    "/api/v1/seller/dashboard/upcoming-drops": {
      "get": {
        "tags": ["판매자 대시보드"],
        "summary": "임박 DROP 조회",
        "description": "판매 시작(START, WISH 기준) 또는 종료(END, GRAB 기준)가 임박한 DROP을 임박 순으로 반환한다. withinMinutes는 60 또는 1440만 허용한다",
        "operationId": "findUpcomingDrops",
        "parameters": [
          {
            "name": "eventType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "START",
              "enum": ["START", "END"]
            }
          },
          {
            "name": "withinMinutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 60
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListUpcomingDropResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListUpcomingDropResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListUpcomingDropResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListUpcomingDropResponse"
                }
              }
            }
          }
        }
      }
    },
