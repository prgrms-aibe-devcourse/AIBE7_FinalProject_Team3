{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "내 WISH",
      "description": "로그인한 사용자의 WISH 목록 조회"
    },
    {
      "name": "WISH",
      "description": "판매 시작 전 DROP의 WISH 등록·취소"
    }
  ],
  "paths": {
    "/api/v1/drops/{dropId}/wish": {
      "put": {
        "tags": ["WISH"],
        "summary": "WISH 등록",
        "description": "판매 시작 전인 WISH DROP에만 등록한다. 반복 요청해도 활성 WISH는 하나이며 기존 wishedAt을 그대로 반환한다",
        "operationId": "register",
        "parameters": [
          {
            "name": "dropId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "등록 성공 또는 이미 등록됨",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWishResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWishResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWishResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED (CSRF 토큰 누락)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWishResponse"
                }
              }
            }
          },
          "404": {
            "description": "DROP_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWishResponse"
                }
              }
            }
          },
          "409": {
            "description": "GRAB_ALREADY_STARTED, DROP_NOT_WISHABLE",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWishResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["WISH"],
        "summary": "WISH 취소",
        "description": "판매 시작 전에만 취소한다. 활성 WISH가 없어도 204로 응답한다",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "dropId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "취소 완료"
          },
          "400": {
            "description": "INVALID_REQUEST"
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN"
          },
          "403": {
            "description": "ACCESS_DENIED (CSRF 토큰 누락)"
          },
          "404": {
            "description": "DROP_NOT_FOUND"
          },
          "409": {
            "description": "GRAB_ALREADY_STARTED, DROP_NOT_WISHABLE"
          }
        }
      }
    },
    "/api/v1/users/me/wishes": {
      "get": {
        "tags": ["내 WISH"],
        "summary": "내 WISH 목록 조회",
        "description": "본인이 등록한 활성 WISH를 반환한다",
        "operationId": "listMyWishes",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseWishListResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseWishListResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseWishListResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseWishListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseWishResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/WishResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "WishResponse": {
        "type": "object",
        "properties": {
          "dropId": {
            "type": "integer",
            "format": "int64"
          },
          "wished": {
            "type": "boolean"
          },
          "wishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notice": {
            "type": "string"
          }
        }
      },
      "ApiResponsePageResponseWishListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/PageResponseWishListResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PageResponseWishListResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WishListResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "WishListResponse": {
        "type": "object",
        "properties": {
          "dropId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "minPrice": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "WISH", "GRAB", "ENDED", "CANCELED"]
          },
          "wishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
