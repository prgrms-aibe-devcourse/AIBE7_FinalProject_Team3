  "components": {
    "schemas": {
      "ShipmentRegisterRequest": {
        "type": "object",
        "properties": {
          "carrier": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "trackingNumber": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": ["carrier", "trackingNumber"]
      },
      "ApiResponseOrderStatusResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
