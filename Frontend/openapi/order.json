          },
          "message": {
            "type": "string"
          }
        }
      },
      "OrderStatusResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "optionId": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": ["optionId", "quantity"]
      },
      "OrderCreateRequest": {
        "type": "object",
