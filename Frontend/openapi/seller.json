          },
          "brandName": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "businessRegistrationNumber": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "appliedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminSellerApplicationResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "brandName": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "businessRegistrationNumber": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "appliedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponsePageResponseAdminSellerApplicationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/PageResponseAdminSellerApplicationResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PageResponseAdminSellerApplicationResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminSellerApplicationResponse"
