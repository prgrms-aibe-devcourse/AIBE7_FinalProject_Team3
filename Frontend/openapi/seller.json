{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "판매자 신청 심사",
      "description": "운영자의 판매자 신청 목록 조회·승인·반려(ADMIN 전용)"
    },
    {
      "name": "판매자 서류",
      "description": "판매자 신청 서류 업로드(암호화 저장)"
    },
    {
      "name": "판매자 신청",
      "description": "일반 회원의 판매자 등록 신청·재신청·내 신청 조회"
    }
  ],
  "paths": {
    "/api/v1/seller-documents": {
      "post": {
        "tags": ["판매자 서류"],
        "summary": "판매자 신청 서류 업로드",
        "description": "서류 1건을 암호화해 비공개 버킷에 저장하고 documentId를 발급한다. 공개 imageUrl은 내려주지 않는다",
        "operationId": "upload",
        "parameters": [
          {
            "name": "documentType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "BUSINESS_LICENSE",
                "ID_CARD",
                "BANKBOOK",
                "MAIL_ORDER_BUSINESS_REPORT"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "업로드 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerDocumentUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerDocumentUploadResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerDocumentUploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/seller-applications": {
      "post": {
        "tags": ["판매자 신청"],
        "summary": "판매자 등록 신청",
        "description": "PENDING·APPROVED 상태면 409, REJECTED면 같은 건을 재신청으로 갱신한다. 사업자등록번호는 국세청 상태조회로 1차 검증한다",
        "operationId": "apply",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SellerApplicationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "신청 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationResponse"
                }
              }
            }
          },
          "409": {
            "description": "SELLER_APPLICATION_ALREADY_EXISTS, DUPLICATE_BUSINESS_REGISTRATION_NUMBER",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationResponse"
                }
              }
            }
          },
          "422": {
            "description": "BUSINESS_NOT_ACTIVE",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/seller-applications/{applicationId}/reject": {
      "post": {
        "tags": ["판매자 신청 심사"],
        "summary": "판매자 신청 반려",
        "description": "사유(reason) 필수. PENDING이 아니면 409 INVALID_STATE_TRANSITION",
        "operationId": "reject",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SellerApplicationRejectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "반려 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationRejectionResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationRejectionResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationRejectionResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationRejectionResponse"
                }
              }
            }
          },
          "404": {
            "description": "SELLER_APPLICATION_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationRejectionResponse"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE_TRANSITION",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationRejectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/seller-applications/{applicationId}/approve": {
      "post": {
        "tags": ["판매자 신청 심사"],
        "summary": "판매자 신청 승인",
        "description": "PENDING이 아니면 409 INVALID_STATE_TRANSITION",
        "operationId": "approve",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "승인 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationApprovalResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationApprovalResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationApprovalResponse"
                }
              }
            }
          },
          "404": {
            "description": "SELLER_APPLICATION_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationApprovalResponse"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_STATE_TRANSITION",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSellerApplicationApprovalResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/seller-applications/me": {
      "get": {
        "tags": ["판매자 신청"],
        "summary": "내 판매자 신청 조회",
        "description": "본인 신청 1건을 조회한다. 없으면 404",
        "operationId": "findMyApplication",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMySellerApplicationResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMySellerApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "SELLER_APPLICATION_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMySellerApplicationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/seller-applications": {
      "get": {
        "tags": ["판매자 신청 심사"],
        "summary": "판매자 신청 목록 조회",
        "description": "status 미지정 시 전체 상태를 반환한다",
        "operationId": "findApplications",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["PENDING", "APPROVED", "REJECTED"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseAdminSellerApplicationResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseAdminSellerApplicationResponse"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseAdminSellerApplicationResponse"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseAdminSellerApplicationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/seller-applications/{applicationId}/documents/{documentType}/view": {
      "get": {
        "tags": ["판매자 신청 심사"],
        "summary": "판매자 신청 서류 열람(전용 뷰어)",
        "description": "응답은 URL이 아니라 복호화+워터마크 합성을 마친 이미지 바이트다. 열람마다 접근 로그를 남긴다",
        "operationId": "viewDocument",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "documentType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "BUSINESS_LICENSE",
                "ID_CARD",
                "BANKBOOK",
                "MAIL_ORDER_BUSINESS_REPORT"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "열람 성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED, INVALID_TOKEN",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "403": {
            "description": "ACCESS_DENIED",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "404": {
            "description": "SELLER_APPLICATION_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseSellerDocumentUploadResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/SellerDocumentUploadResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SellerDocumentUploadResponse": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "documentType": {
            "type": "string",
            "enum": [
              "BUSINESS_LICENSE",
              "ID_CARD",
              "BANKBOOK",
              "MAIL_ORDER_BUSINESS_REPORT"
            ]
          }
        }
      },
      "SellerApplicationRequest": {
        "type": "object",
        "properties": {
          "brandName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "businessRegistrationNumber": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "documentIds": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "uuid"
            },
            "minProperties": 1
          }
        },
        "required": [
          "brandName",
          "businessRegistrationNumber",
          "contactEmail",
          "documentIds"
        ]
      },
      "ApiResponseSellerApplicationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/SellerApplicationResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SellerApplicationResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "brandName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "appliedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SellerApplicationRejectRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["reason"]
      },
      "ApiResponseSellerApplicationRejectionResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/SellerApplicationRejectionResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SellerApplicationRejectionResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "rejectedReason": {
            "type": "string"
          },
          "rejectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponseSellerApplicationApprovalResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/SellerApplicationApprovalResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SellerApplicationApprovalResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "APPROVED", "REJECTED"]
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponseMySellerApplicationResponse": {
