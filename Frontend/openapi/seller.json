          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/MySellerApplicationResponse"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MySellerApplicationResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
