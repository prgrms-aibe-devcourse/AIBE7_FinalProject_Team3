# 개발 서버의 /api 요청을 전달할 백엔드 주소 (미설정·빈 값이면 localhost:8080)
VITE_API_PROXY_TARGET=http://localhost:8080

# 토스페이먼츠 테스트 클라이언트 키(test_ck_, API 개별 연동 키). 백엔드 TOSS_SECRET_KEY와 짝이 되는 값을 .env.local에 넣고 이 파일에는 적지 않는다.
VITE_TOSS_CLIENT_KEY=

# 배포된 프론트엔드 원점 주소(끝의 / 제외). 링크 공유 미리보기(og:url·og:image)의 절대 URL에 쓴다. 배포 빌드에서 필수
VITE_SITE_URL=
