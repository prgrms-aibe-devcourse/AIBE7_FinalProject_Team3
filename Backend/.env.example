# 로컬 PostgreSQL 컨테이너의 개발용 비밀번호다.
# 실제 운영 비밀번호는 이 파일에 저장하지 않는다.
DB_PASSWORD=**********
# 토스페이먼츠 결제창 연동 테스트 키 (개발자센터 > API 키 > API 개별 연동 키).
# 클라이언트 키(test_gck_)와 시크릿 키(test_gsk_)는 같은 세트로 쓴다. 실제 값은 .env에만 넣는다.
TOSS_CLIENT_KEY=test_ck_**************
TOSS_SECRET_KEY=test_sk_**************

# Supabase Storage(GR-51) 이미지 업로드 URL 발급용 설정.
# Secret Key는 RLS를 우회하므로 서버에서만 쓰고 저장소·이미지·로그·응답에 남기지 않는다. 실제 값은 .env에만 넣는다.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_**********
SUPABASE_DROP_IMAGE_BUCKET=drop-images

# 로컬 Redis 컨테이너의 개발용 비밀번호다. compose의 redis(requirepass)와 backend가 같은 값을 쓴다.
# 실제 운영 비밀번호는 이 파일에 저장하지 않는다.
REDIS_PASSWORD=grab

# Access Token(JWT) 서명 키. Base64로 인코딩한 32바이트 이상의 무작위 값이어야 한다.
# 각자 아래 명령으로 생성해 .env에 넣는다. 환경마다 다른 키를 쓰고, 이 파일에는 값을 적지 않는다.
# openssl rand -base64 32
JWT_SECRET=

# 메일 본문 링크가 가리키는 프런트엔드 주소(grab.web.base-url). 비워 두면 http://localhost:5173을 쓴다.
# 받는 사람의 브라우저가 여는 주소이므로, 배포 환경에서는 실제 서비스 도메인을 넣는다.
WEB_BASE_URL=

# 메일 발송(SMTP) 설정. 설정 방법과 환경별 값은 docs/MAIL.md를 따른다.
# 비워 두면 compose의 backend 서비스는 로컬 Mailpit(mailpit:1025, 인증·STARTTLS 없음)으로 보낸다.
# Gmail로 시험할 때만 docs/MAIL.md 4절의 값을 .env에 넣는다. 앱 비밀번호는 .env에만 두고 이 파일에는 적지 않는다.
# 호스트에서 직접 실행할 때 이 키를 빈 값으로 환경변수에 넣으면 기본값 대신 빈 문자열이 적용되므로, 쓰지 않는 키는 넣지 않는다.
# 운영 계정과 앱 비밀번호는 Parameter Store로 주입한다.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
MAIL_FROM=

# WISH 판매 알림(GR-69) 전용 발송처. 위 MAIL_* (인증 코드용)과 계정을 나눠, 알림이 인증 코드의 일일 한도를 먹지 않게 한다.
# BREVO_SMTP_HOST를 비워 두면 발송처가 등록되지 않고, 알림도 위 MAIL_* 설정(로컬 Mailpit)으로 나간다.
# SMTP 키는 Brevo 계정 비밀번호가 아니라 대시보드에서 발급한 SMTP 전용 키다. 실제 값은 .env에만 넣는다.

# Brevo(무료 300통/일). 대시보드 > SMTP & API > SMTP의 Login과 SMTP key를 넣는다.
# BREVO_MAIL_FROM은 Brevo에 등록·검증한 발신 주소여야 한다.
# 도메인을 인증하지 않으면 Brevo가 발신 주소를 자기 도메인(@brevosend.com)으로 바꿔 보낸다.
# 쓸 때만 BREVO_SMTP_HOST=smtp-relay.brevo.com 을 채운다. 호스트만 넣고 키를 비우면 발송처가 등록된 채 인증에 실패한다.
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_MAIL_FROM=
